<?xml version="1.0" encoding="utf-8"?>
<!-- updatePeriodMillis=0: the Flutter side pushes an update through
     home_widget whenever the data changes, so no polling is needed.
     previewImage is the pre-API-31 fallback for previewLayout. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_small_description"
    android:initialLayout="@layout/widget_small"
    android:minHeight="40dp"
    android:minWidth="110dp"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_small"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="1"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
